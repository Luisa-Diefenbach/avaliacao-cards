// =============================================================
//  Sistema de Flashcards de Estudo - Schema do banco (PRONTO)
//  NÃO É NECESSÁRIO ALTERAR ESTE ARQUIVO DURANTE A PROVA.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Baralho: agrupa vários cards (1 Deck -> N Cards)
model Deck {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  cards Card[]
}

// Card de estudo: pergunta + resposta, pertence a um baralho
model Card {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())

  // Relacionamento N:1 com Deck
  deckId Int
  deck   Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)

  // Campos usados apenas no BÔNUS (POST /cards/:id/review)
  reviewCount    Int       @default(0)
  lastGrade      Int?
  lastReviewedAt DateTime?
}

model Category{
  id Int @id @default(autoincrement())
  name String @unique
}

model Product{
  id Int @id @default(autoincrement())
  name String
  price Float
  amount Int
}