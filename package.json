{
  "name": "flashcards-avaliacao",
  "version": "1.0.0",
  "description": "Avaliação prática - Sistema de Flashcards de Estudo (Fastify + Zod + Prisma)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "4.0.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prisma": "^6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
